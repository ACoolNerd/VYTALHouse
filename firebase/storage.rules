rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /vytal/documents/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.role in ["owner", "admin", "operations", "clinical"];
      allow write: if request.auth != null && request.auth.token.role in ["owner", "admin"];
    }
    match /vytal/operations/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.role in ["owner", "admin", "operations"];
    }
    match /vytal/public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role in ["owner", "admin", "marketing"];
    }
    match /vytal/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.role in ["owner", "admin"];
    }
  }
}
